# Database URL (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Gemini API Key for AI chat features
GEMINI_API_KEY="your-gemini-api-key"

# Better Auth Configuration
BETTER_AUTH_URL="http://localhost:3000"
# Generate a secure 32-character high-entropy secret using: npx auth secret
BETTER_AUTH_SECRET="your-high-entropy-secret-minimum-32-chars"

# Administrator Email (Access to Admin Control Panel)
ADMIN_EMAIL="admin@example.com"
