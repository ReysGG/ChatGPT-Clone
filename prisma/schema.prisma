// Starter models — replace with your own
// Domain: Personal AI Chat App (conversations <-> messages is the 1-to-many relation)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  settings      Setting[]
  tags          Tag[]
  sessions      Session[]
  accounts      Account[]
  promptTemplates PromptTemplate[]
  memories      Memory[]
  uploads       Upload[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Conversation {
  id        String    @id @default(cuid())
  title     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[] // one-to-many relation
  tags      ConversationTag[]
  isShared  Boolean   @default(false)
  shareId   String?   @unique
  sharedAt  DateTime?
  uploads   Upload[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user" | "assistant" | "system"
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Setting {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultModel  String?
  systemPrompt  String?
  temperature   Float    @default(0.7)
  darkMode      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Tag {
  id        String            @id @default(cuid())
  name      String
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  links     ConversationTag[]
  createdAt DateTime          @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model ConversationTag {
  conversationId String
  tagId          String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@index([tagId])
}

model PromptTemplate {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  category  String?  @default("Umum")
  isGlobal  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model Upload {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  filename       String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  extractedText  String?
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([conversationId])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bookmark {
  id        String   @id @default(cuid())
  url       String
  title     String?
  createdAt DateTime @default(now())
}

model AppSetting {
  id                         String   @id @default("global")
  defaultModel               String   @default("gemini-2.5-flash-lite")
  defaultSystemPrompt        String   @default("You are a helpful personal AI assistant.")
  defaultTemperature         Float    @default(0.7)
  registrationEnabled        Boolean  @default(true)
  sharingEnabled             Boolean  @default(true)
  maxMessagesPerChat         Int      @default(100)
  maxPromptLength            Int      @default(4000)
  maxMessagesPerUserPerDay   Int      @default(50)
  rateLimitMessagesPerMinute Int      @default(10)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model UsageEvent {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  type           String   // e.g., "chat_message"
  provider       String?  // e.g., "gemini"
  model          String?  // e.g., "gemini-2.5-flash-lite"
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}


